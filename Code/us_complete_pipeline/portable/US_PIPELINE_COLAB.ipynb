    "    'class SimpleDataFrame:\\n'\n",
    "    '    \"\"\"Tiny fallback used only when pandas is unavailable in local self-tests.\"\"\"\\n'\n",
    "    '\\n'\n",
    "    '    def __init__(\\n'\n",
