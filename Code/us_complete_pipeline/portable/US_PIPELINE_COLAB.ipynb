    "    '\\n'\n",
    "    '\\n'\n",
    "    'def _parse_a1_single_column_range(range_name: str) -> tuple[str, int, int | None]:\\n'\n",
    "    '    if \":\" in range_name:\\n'\n",
    "    '        start, end = range_name.split(\":\", 1)\\n'\n",
    "    '    else:\\n'\n",
