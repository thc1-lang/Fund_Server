    "    '    return [headers, *rows]\\n'\n",
    "    '\\n'\n",
    "    '\\n'\n",
    "    'def decimal_places(value: float) -> int:\\n'\n",
    "    '    token = format(float(value), \".12f\").rstrip(\"0\").rstrip(\".\")\\n'\n",
    "    '    return len(token.split(\".\", 1)[1]) if \".\" in token else 0\\n'\n",
    "    '\\n'\n",
    "    '\\n'\n",
