    "    '    return make_dataframe(provisional, REAL_GOVERNMENT_SPENDING_OUTPUT_COLUMNS)\\n'\n",
    "    '\\n'\n",
    "    '\\n'\n",
    "    'def _fiscal_balance_regime(c: Any, f: Any) -> str:\\n'\n",
    "    '    if is_blank(c):\\n'\n",
    "    '        return \"\"\\n'\n",
    "    '    if is_blank(f):\\n'\n",
    "    '        return \"Mixed fiscal balance regime\"\\n'\n",
