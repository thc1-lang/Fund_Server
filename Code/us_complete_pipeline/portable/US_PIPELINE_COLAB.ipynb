    "    '            elif command in (\"cot\", \"cot-import\", \"us-cot-import\"):\\n'\n",
    "    '                if time.monotonic() - self.last_cot_launch < 30 or cot_busy():\\n'\n",
    "    '                    reply = \"Already running or recently requested.\\\\n\" + cot_status()\\n'\n",
    "    '                else:\\n'\n",
