    "    '\\n'\n",
    "    '\\n'\n",
    "    'def _fiscal_sustainability_risk_score(c: Any, af: Any, q: Any) -> Any:\\n'\n",
    "    '    if any(is_blank(x) for x in (c, af, q)):\\n'\n",
    "    '        return \"\"\\n'\n",
    "    '    if c < -8 and q >= 6:\\n'\n",
    "    '        return -7\\n'\n",
