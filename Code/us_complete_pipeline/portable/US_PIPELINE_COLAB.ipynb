    "    '    momentum_scores: list[Any] = []\\n'\n",
    "    '    provisional: list[dict[str, Any]] = []\\n'\n",
    "    '    for idx, raw_source in enumerate(source_values):\\n'\n",
    "    '        c = moving_averages[idx]\\n'\n",
