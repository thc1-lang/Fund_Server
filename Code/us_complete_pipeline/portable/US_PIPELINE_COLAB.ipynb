    "    '        send_telegram(reply, \"Telegram control\")\\n'\n",
    "    '\\n'\n",
    "    '    def toggle_logs(self, source=\"macro\"):\\n'\n",
    "    '        if self.log_watch is not None:\\n'\n",
    "    '            self.log_watch = None\\n'\n",
