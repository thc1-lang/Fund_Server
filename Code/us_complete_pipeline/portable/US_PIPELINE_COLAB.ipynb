    "    '    )\\n'\n",
    "    '\\n'\n",
    "    '    class FakeCorporateSpreadWorksheet:\\n'\n",
    "    '        def __init__(self, rows: list[list[Any]]) -> None:\\n'\n",
    "    '            self.rows = rows\\n'\n",
    "    '            self.get_calls: list[tuple[str, str | None]] = []\\n'\n",
    "    '            self.update_calls: list[tuple[str, list[list[Any]], str]] = []\\n'\n",
