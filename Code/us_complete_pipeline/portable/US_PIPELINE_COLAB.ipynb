    "    '\\n'\n",
    "    '    # 2008-2009 stress-level Q rows and the August transition back to Elevated.\\n'\n",
    "    '    for c_value, f_value in (\\n'\n",
    "    '        (4.793333333333333, 1.6666666666666665),\\n'\n",
