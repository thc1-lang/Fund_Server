    "    '            else \"\"\\n'\n",
    "    '        )\\n'\n",
    "    '        z = (\\n'\n",
    "    '            round(clamp(0.35 * u + 0.45 * v + 0.2 * w), 2)\\n'\n",
    "    '            if all(val != \"\" for val in (u, v, w))\\n'\n",
