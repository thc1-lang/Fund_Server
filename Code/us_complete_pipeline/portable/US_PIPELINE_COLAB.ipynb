    "    '        batch_response = google_sheets_request(\\n'\n",
    "    '            \"GET\",\\n'\n",
    "    '            f\"{base_url}/values:batchGet?{query}\",\\n'\n",
    "    '            access_token,\\n'\n",
    "    '        )\\n'\n",
    "    '    else:\\n'\n",
    "    '        batch_response = (\\n'\n",
