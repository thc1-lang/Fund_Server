    "    '        return (len(self._rows), len(self.columns))\\n'\n",
    "    '\\n'\n",
    "    '    def to_rows(self) -> list[list[Any]]:\\n'\n",
    "    '        return [[r.get(c, \"\") for c in self.columns] for r in self._rows]\\n'\n",
    "    '\\n'\n",
