{
  "version": "factor-rules-v2",
  "factors": [
    {"factor_key":"business_quality_revenue_state","factor_name":"Revenue current state","pillar":"BUSINESS_QUALITY","description":"Audited qualitative revenue state; not scored until absolute quality is explicitly evidenced.","input_source":"qualitative_states","input_field":"current_state","mapping_rule":"state:revenue","weight":1.0,"critical":true,"min_coverage":0.5,"rule_version":"state-map-v2","dependency_group":"revenue_state_and_trajectory","semantic_class":"NOT_SAFELY_SCORABLE"},
    {"factor_key":"business_quality_demand_state","factor_name":"Demand current state","pillar":"BUSINESS_QUALITY","description":"Audited qualitative demand state; not scored until an absolute benchmark is explicit.","input_source":"qualitative_states","input_field":"current_state","mapping_rule":"state:demand","weight":1.0,"critical":true,"min_coverage":0.5,"rule_version":"state-map-v2","dependency_group":"demand_state_and_trajectory","semantic_class":"NOT_SAFELY_SCORABLE"},
    {"factor_key":"business_quality_margins_state","factor_name":"Margins current state","pillar":"BUSINESS_QUALITY","description":"Margins expanding/compressing are directional changes, not absolute quality states.","input_source":"qualitative_states","input_field":"current_state","mapping_rule":"state:margins","weight":1.0,"critical":false,"min_coverage":0.5,"rule_version":"state-map-v2","dependency_group":"margins_state_and_trajectory","semantic_class":"NOT_SAFELY_SCORABLE"},
    {"factor_key":"business_quality_guidance_state","factor_name":"Guidance current state","pillar":"BUSINESS_QUALITY","description":"Guidance raises/cuts are actions or changes, not absolute business quality.","input_source":"qualitative_states","input_field":"current_state","mapping_rule":"state:guidance","weight":0.75,"critical":false,"min_coverage":0.5,"rule_version":"state-map-v2","dependency_group":"qualitative_state_guidance","semantic_class":"NOT_SAFELY_SCORABLE"},
    {"factor_key":"trajectory_revenue_trend","factor_name":"Revenue trajectory","pillar":"BUSINESS_TRAJECTORY","description":"Audited temporal revenue trend.","input_source":"qualitative_states","input_field":"trend","mapping_rule":"trend:revenue","weight":1.0,"rule_version":"trend-map-v1","dependency_group":"revenue_state_and_trajectory","semantic_class":"DIRECTIONAL_CHANGE"},
    {"factor_key":"trajectory_demand_trend","factor_name":"Demand trajectory","pillar":"BUSINESS_TRAJECTORY","description":"Audited temporal demand trend.","input_source":"qualitative_states","input_field":"trend","mapping_rule":"trend:demand","weight":1.0,"rule_version":"trend-map-v1","dependency_group":"demand_state_and_trajectory","semantic_class":"DIRECTIONAL_CHANGE"},
    {"factor_key":"trajectory_margins_trend","factor_name":"Margins trajectory","pillar":"BUSINESS_TRAJECTORY","description":"Audited temporal margin trend.","input_source":"qualitative_states","input_field":"trend","mapping_rule":"trend:margins","weight":1.0,"rule_version":"trend-map-v1","dependency_group":"margins_state_and_trajectory","semantic_class":"DIRECTIONAL_CHANGE"},
    {"factor_key":"trajectory_risk_trend","factor_name":"Risk trajectory","pillar":"BUSINESS_TRAJECTORY","description":"Audited temporal risk trend.","input_source":"qualitative_states","input_field":"trend","mapping_rule":"trend:risks","weight":0.75,"rule_version":"trend-map-v1","dependency_group":"temporal_risks","semantic_class":"DIRECTIONAL_CHANGE"},
    {"factor_key":"management_guidance_reliability","factor_name":"Guidance reliability","pillar":"MANAGEMENT_EXECUTION","description":"Resolved comparable guidance outcomes only.","input_source":"guidance_outcomes","input_field":"outcome","mapping_rule":"guidance_outcome","weight":1.0,"min_sample":3,"rule_version":"guidance-map-v1","dependency_group":"guidance_outcome"},
    {"factor_key":"management_commitment_delivery","factor_name":"Strategic commitment delivery","pillar":"MANAGEMENT_EXECUTION","description":"Resolved material strategic commitment outcomes.","input_source":"strategic_outcomes","input_field":"outcome","mapping_rule":"commitment_outcome","weight":0.75,"min_sample":2,"rule_version":"commitment-map-v1","dependency_group":"strategic_outcome"},
    {"factor_key":"management_operating_execution","factor_name":"Operating execution evidence","pillar":"MANAGEMENT_EXECUTION","description":"Explicitly attributed operating outcomes.","input_source":"operating_outcomes","input_field":"percent_change","mapping_rule":"operating_outcome","weight":0.75,"min_sample":3,"rule_version":"operating-map-v1","dependency_group":"operating_outcome"},
    {"factor_key":"management_capital_allocation","factor_name":"Capital allocation execution","pillar":"MANAGEMENT_EXECUTION","description":"Explicitly evidenced capital allocation outcomes.","input_source":"capital_allocation_events","input_field":"event_status","mapping_rule":"capital_outcome","weight":0.5,"min_sample":1,"rule_version":"capital-map-v1","dependency_group":"capital_outcome"},
    {"factor_key":"insider_ownership_alignment","factor_name":"Insider ownership alignment","pillar":"INSIDER_ALIGNMENT","description":"Known beneficial ownership alignment, kept separate from voting control.","input_source":"alignment_snapshots","input_field":"known_insider_percent","mapping_rule":"ownership_percent","weight":1.0,"rule_version":"ownership-map-v1","dependency_group":"insider_ownership"},
    {"factor_key":"insider_transaction_activity","factor_name":"Discretionary insider transactions","pillar":"INSIDER_ALIGNMENT","description":"Eligible open-market discretionary purchases or sales.","input_source":"transactions","input_field":"transaction_type","mapping_rule":"insider_transactions","weight":1.0,"rule_version":"transaction-map-v1","dependency_group":"insider_transactions"},
    {"factor_key":"insider_cluster_activity","factor_name":"Insider transaction clusters","pillar":"INSIDER_ALIGNMENT","description":"Eligible multi-insider discretionary clusters.","input_source":"clusters","input_field":"transaction_type","mapping_rule":"insider_clusters","weight":0.5,"rule_version":"cluster-map-v1","dependency_group":"insider_clusters"},
    {"factor_key":"governance_board_independence","factor_name":"Board independence","pillar":"GOVERNANCE","description":"Known independent directors divided by total board, with unknowns reducing coverage.","input_source":"governance_snapshots","input_field":"independent_percentage","mapping_rule":"board_independence","weight":1.0,"min_coverage":0.5,"rule_version":"governance-map-v1","dependency_group":"governance_board"},
    {"factor_key":"governance_leadership_structure","factor_name":"Leadership structure","pillar":"GOVERNANCE","description":"Configured chair and lead-director structure mapping.","input_source":"governance_snapshots","input_field":"chair_structure","mapping_rule":"leadership_structure","weight":0.75,"min_coverage":1.0,"rule_version":"governance-map-v1","dependency_group":"governance_leadership"},
    {"factor_key":"governance_committee_independence","factor_name":"Committee independence","pillar":"GOVERNANCE","description":"Committee independence where explicitly known.","input_source":"governance_committees","input_field":"independence","mapping_rule":"committee_independence","weight":0.75,"min_coverage":0.75,"rule_version":"governance-map-v1","dependency_group":"governance_committees"},
    {"factor_key":"governance_audit_expertise","factor_name":"Audit financial expertise","pillar":"GOVERNANCE","description":"Explicit audit financial expert designation only.","input_source":"governance_committees","input_field":"financial_experts","mapping_rule":"audit_expertise","weight":0.5,"min_coverage":1.0,"rule_version":"governance-map-v1","dependency_group":"governance_audit"},
    {"factor_key":"governance_refreshment","factor_name":"Board refreshment","pillar":"GOVERNANCE","description":"Explicit refreshment evidence; tenure alone is not a quality judgment.","input_source":"governance_refreshment","input_field":"outcome","mapping_rule":"refreshment","weight":0.5,"min_coverage":1.0,"rule_version":"governance-map-v1","dependency_group":"governance_refreshment"},
    {"factor_key":"governance_outside_board_burden","factor_name":"Outside-board burden","pillar":"GOVERNANCE","description":"Confirmed current public-company board roles only.","input_source":"governance_overboarding","input_field":"outside_public_board_count","mapping_rule":"outside_boards","weight":0.5,"min_coverage":1.0,"rule_version":"governance-map-v1","dependency_group":"governance_overboarding"},
    {"factor_key":"governance_related_party","factor_name":"Related-party governance","pillar":"GOVERNANCE","description":"Explicit related-party coverage only.","input_source":"governance_related_parties","input_field":"relationship_count","mapping_rule":"related_party","weight":0.5,"min_coverage":1.0,"rule_version":"governance-map-v1","dependency_group":"governance_related"},
    {"factor_key":"governance_voting_control","factor_name":"Voting-control concentration","pillar":"GOVERNANCE","description":"Voting control is separate from economic ownership.","input_source":"governance_snapshots","input_field":"voting_percentage","mapping_rule":"voting_control","weight":0.75,"min_coverage":1.0,"rule_version":"governance-map-v1","dependency_group":"governance_voting"},
    {"factor_key":"governance_shareholder_rights","factor_name":"Shareholder rights","pillar":"GOVERNANCE","description":"Known core rights only; unknown rights do not imply an adverse result.","input_source":"governance_snapshots","input_field":"shareholder_rights","mapping_rule":"shareholder_rights","weight":0.75,"min_coverage":1.0,"rule_version":"governance-map-v1","dependency_group":"governance_rights"},
    {"factor_key":"governance_class_structure","factor_name":"Share-class structure","pillar":"GOVERNANCE","description":"Factual class structure without an automatic penalty.","input_source":"governance_snapshots","input_field":"share_class_structure","mapping_rule":"class_structure","weight":0.25,"min_coverage":1.0,"rule_version":"governance-map-v1","dependency_group":"governance_voting"}
  ],
  "mappings": {
    "state": {
      "revenue": {"strong":100,"healthy":75,"neutral":50,"weak":25,"stressed":0},
      "demand": {"strong":100,"healthy":75,"neutral":50,"weak":25,"stressed":0},
      "margins": {"expanding":100,"stable":50,"compressing":0,"strong":75,"healthy":75,"weak":25,"stressed":0},
      "guidance": {"raised":100,"maintained":50,"lowered":25,"withdrawn":0,"neutral":50}
    },
    "trend": {"revenue":{"accelerating":100,"improving":75,"stable":50,"deteriorating":25,"decelerating":0},"demand":{"accelerating":100,"improving":75,"stable":50,"deteriorating":25,"decelerating":0},"margins":{"accelerating":100,"improving":75,"stable":50,"deteriorating":25,"decelerating":0},"risks":{"improving":100,"stable":50,"deteriorating":25,"decelerating":0}},
    "leadership_structure": {"SEPARATE_INDEPENDENT_CHAIR":100,"SEPARATE_NONINDEPENDENT_CHAIR":65,"CEO_CHAIR_WITH_LEAD_INDEPENDENT_DIRECTOR":70,"CEO_CHAIR_WITHOUT_LEAD_INDEPENDENT_DIRECTOR":35},
    "guidance_outcome": {"BEAT":100,"MET":75,"MISS":25,"WITHDRAWN":0},
    "commitment_outcome": {"ACHIEVED":100,"PARTIALLY_ACHIEVED":65,"REVISED":50,"DELAYED":25,"MISSED":0,"ABANDONED":0},
    "capital_outcome": {"positive":100,"successful":100,"achieved":100,"negative":0,"missed":0},
    "ownership_percent_bands": [{"min":0,"max":1,"score":25},{"min":1,"max":5,"score":50},{"min":5,"max":10,"score":75},{"min":10,"max":101,"score":100}],
    "class_structure": {"single_class":50,"dual_class":50,"multi_class":50},
